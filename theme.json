	"styles": {
		"blocks": {
			"core/button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--custom-slate-ink)"
					}
				},
				"border": {
					"radius": {
						"bottomLeft": "3px",
						"bottomRight": "3px",
						"topLeft": "3px",
						"topRight": "3px"
					}
				},
				"color": {
					"background": "var(--wp--preset--color--custom-harbor-blue)",
					"text": "var(--wp--preset--color--white)"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--white)"
						}
					}
				},
				"spacing": {
					"padding": {
						"bottom": "15px",
						"left": "26px",
						"right": "26px",
						"top": "15px"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--nunito-sans)",
					"fontSize": "16px",
					"fontStyle": "normal",
					"fontWeight": "600",
					"textDecoration": "none"
				},
				"variations": {
					"outline": {
						":hover": {
							"color": {
								"background": "var(--wp--preset--color--custom-slate-ink)",
								"text": "var(--wp--preset--color--custom-white)"
							}
						},
						"border": {
							"bottom": {
								"color": "var(--wp--preset--color--custom-slate-ink)",
								"style": "solid",
								"width": "2px"
							},
							"color": null,
							"left": {
								"color": "var(--wp--preset--color--custom-slate-ink)",
								"style": "solid",
								"width": "2px"
							},
							"radius": {
								"bottomLeft": "3px",
								"bottomRight": "3px",
								"topLeft": "3px",
								"topRight": "3px"
							},
							"right": {
								"color": "var(--wp--preset--color--custom-slate-ink)",
								"style": "solid",
								"width": "2px"
							},
							"style": null,
							"top": {
								"color": "var(--wp--preset--color--custom-slate-ink)",
								"style": "solid",
								"width": "2px"
							},
							"width": null
						},
						"color": {
							"text": "var(--wp--preset--color--custom-slate-ink)"
						},
						"spacing": {
							"padding": {
								"bottom": "15px",
								"left": "26px",
								"right": "26px",
								"top": "15px"
							}
						}
					}
				}
			}
		},
		"color": {
			"background": "var(--wp--preset--color--custom-lace)",
			"text": "var(--wp--preset--color--custom-slate-ink)"
		},
		"css": "",
		"elements": {
			"button": {
				"color": {
					"text": "var(--wp--preset--color--custom-harbor-blue)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--nunito-sans)",
					"fontWeight": "200"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--custom-slate-gray)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--libre-caslon-text)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"letterSpacing": "-1px",
					"lineHeight": "1.06"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.1"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--custom-1)",
					"lineHeight": "1.12"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--custom-slate-ink)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--libre-caslon-text)",
					"fontStyle": "normal",
					"fontWeight": "400"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--custom-harbor-blue)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--nunito-sans)",
					"textDecoration": "none"
				}
			}
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--20)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--nunito-sans)",
			"fontSize": "16px",
			"fontStyle": "normal",
			"fontWeight": "400",
			"lineHeight": "1.5"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}